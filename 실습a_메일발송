
function 휴면고객_메일발송() {

  // ========================================
  // 1. 기본 설정
  // ========================================



  // 테스트 모드 설정
  // const 테스트모드 = true;  : 모든 메일을 내 이메일 주소로 발송
  // const 테스트모드 = false; : 고객의 실제 이메일 주소로 발송

  const 테스트모드 = true;
----------------------------------------------
  // 테스트 모드에서 사용할 내 이메일 주소
  const 내이메일주소 = "내이메일@gmail.com";  
------------------------------------

  // 메일을 보낼 때 사용할 제목
  const 메일제목 = "[안내] 고객님께 드리는 안내 메일";

  // 고객명단 시트 가져오기
  const 시트 = SpreadsheetApp.getActiveSpreadsheet()
    .getSheetByName("고객명단");

  // 시트가 없으면 오류 메시지 표시 후 종료
  if (!시트) {
    throw new Error("'고객명단' 시트를 찾을 수 없습니다.");
  }

  // ========================================
  // 2. 고객 데이터 가져오기
  // ========================================

  // 전체 데이터의 마지막 행 확인
  const 마지막행 = 시트.getLastRow();

  // 제목행만 있으면 작업 종료
  if (마지막행 < 2) {
    Logger.log("발송할 고객 데이터가 없습니다.");
    return;
  }

  // A열부터 G열까지 데이터 가져오기
  // 1행은 제목이므로 2행부터 가져옴
  const 데이터 = 시트.getRange(2, 1, 마지막행 - 1, 7)
    .getValues();

  // 오늘 날짜 가져오기
  const 오늘날짜 = new Date();

  // ========================================
  // 3. 고객별 조건 확인 및 메일 발송
  // ========================================

  for (let i = 0; i < 데이터.length; i++) {

    // 각 열의 데이터 가져오기
    const 고객명 = 데이터[i][0];   // A열 : 이름
    const 이메일 = 데이터[i][1];   // B열 : 이메일
    const 등급 = 데이터[i][2];     // C열 : 등급
    const 발송여부 = 데이터[i][6]; // G열 : 발송여부

    // C열이 '휴면'이고 G열이 비어 있는 경우만 실행
    if (등급 === "휴면" && 발송여부 === "") {

      // 테스트 모드이면 내 이메일 주소로 발송
      // 테스트 모드가 아니면 고객 이메일 주소로 발송
      const 받는사람 = 테스트모드
        ? 내이메일주소
        : 이메일;

      // 이메일 주소가 비어 있으면 건너뛰기
      if (!받는사람) {
        Logger.log((i + 2) + "행 : 이메일 주소가 없습니다.");
        continue;
      }

      // 고객 이름을 포함한 메일 본문 작성
      const 메일본문 =
        고객명 + " 고객님, 안녕하세요.\n\n" +
        "고객님의 계정이 현재 휴면 상태임을 안내드립니다.\n" +
        "서비스 이용을 원하시면 다시 방문해 주세요.\n\n" +
        "감사합니다.";

      // 이메일 발송
      GmailApp.sendEmail(
        받는사람,
        메일제목,
        메일본문
      );

      // 메일 발송 후 G열에 오늘 날짜 기록
      // 데이터의 첫 번째 행은 실제 시트의 2행이므로 i + 2
      시트.getRange(i + 2, 7).setValue(오늘날짜);

      // 실행 기록 출력
      Logger.log(
        (i + 2) + "행 : " + 고객명 +
        " 메일 발송 완료 (" + 받는사람 + ")"
      );

    }
  }

  Logger.log("휴면 고객 메일 발송 작업이 완료되었습니다.");

}
