
function createContentCalendarEvents() {

  // 현재 스프레드시트와 '콘텐츠일정' 시트 가져오기
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheet = ss.getSheetByName('콘텐츠일정');

  // 시트가 없으면 종료
  if (!sheet) {
    throw new Error("'콘텐츠일정' 시트를 찾을 수 없습니다.");
  }

  // 마지막 데이터 행 확인
  const lastRow = sheet.getLastRow();

  // 제목행만 있거나 데이터가 없으면 종료
  if (lastRow < 2) {
    return;
  }

  // A~E열 데이터 가져오기 (1행은 제목행)
  const data = sheet.getRange(2, 1, lastRow - 1, 5).getValues();

  // 내 구글 캘린더 가져오기
  const calendar = CalendarApp.getDefaultCalendar();

  // 각 행을 순회하며 캘린더 일정 등록
  data.forEach((row, index) => {

    // 각 열의 값 가져오기
    const date = row[0];       // A열: 날짜
    const channel = row[1];   // B열: 채널
    const title = row[2];     // C열: 콘텐츠 제목
    const manager = row[3];   // D열: 담당자
    const status = row[4];    // E열: 상태

    // 이미 등록완료된 행은 건너뛰기
    if (status === '등록완료') {
      return;
    }

    // 날짜가 유효하지 않으면 건너뛰기
    if (!(date instanceof Date) || isNaN(date.getTime())) {
      return;
    }

    // 제목과 채널이 없는 행은 건너뛰기
    if (!channel || !title) {
      return;
    }

    // 캘린더 일정 제목 만들기
    const eventTitle = `[${channel}] ${title}`;

    // 캘린더 일정 설명 만들기
    const description = `담당자: ${manager || '미지정'}`;

    // 종일 일정 생성
    calendar.createAllDayEvent(
      eventTitle,
      date,
      {
        description: description
      }
    );

    // 캘린더 등록 성공 후 E열 상태 변경
    const sheetRow = index + 2;
    sheet.getRange(sheetRow, 5).setValue('등록완료');

  });

}
